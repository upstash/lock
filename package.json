{
  "name": "@upstash/lock",
  "version": "0.0.0",
  "description": "A distributed lock implementation using Upstash Redis",
  "author": "Meshan Khosla <meshan@upstash.com>",
  "license": "MIT",
  "homepage": "https://github.com/upstash/lock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upstash/lock.git"
  },
  "bugs": {
    "url": "https://github.com/upstash/lock/issues"
  },
  "keywords": ["redis", "lock", "upstash", "redlock"],
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "files": ["./*"],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "scripts": {
    "build": "tsup && cp README.md LICENSE package.json ./dist/",
    "test": "bun test src --coverage",
    "fmt": "bunx @biomejs/biome check --apply ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.3.1",
    "@types/node": "^20.8.9",
    "@upstash/redis": "^1.24.1",
    "bun-types": "^1.0.7",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
